 *
 * 让 V1 组件在 V2 宿主里保持同一套视觉规范
 *
 * V2 复用了一批 V1 组件（平台配置表单、发布表单、文章管理表格）。它们用的是
 * Element Plus 的默认尺寸，直接放进 V2 面板会明显偏大、间距松散，与 V2 面板
 * 自身的排版对不上，看起来像两个界面拼在一起。
 *
 * 本 mixin 把这些组件统一压到与 V2 一致的紧凑尺寸（12px 字、24px 行高）。
 * 用法：在桥接容器的根类下引入，例如
 *
 *   .syp-single-view
 *     syp-compact-legacy()
 *
 * 只改尺寸与间距，不改任何行为。
 *
 * 注意：成组控件（el-button-group、el-radio-button 分段、输入框前后缀）
 * 靠相邻边框重叠成一体，通用间距/圆角规则会把它们拆散，Mixin 里已单独还原。
 * 新增规则前先确认目标页面有没有这类控件。
 */

@import "./variables.styl"

syp-compact-legacy()
  :deep(.el-form)
    width 100%
    max-width 100%
    overflow visible

  :deep(.el-form-item)
    margin-right 0
    margin-bottom 6px

  :deep(.el-form-item__label)
    min-height 24px
    padding-right 8px
    font-size 12px
    line-height 24px

  :deep(.el-form-item__content)
    min-width 0
    min-height 24px
    gap 4px

  :deep(.el-input),
  :deep(.el-input__wrapper),
  :deep(.el-textarea),
  :deep(.el-select)
    max-width 100%

  // 输入类控件对齐「平台详情页」的高度（那边渲染出来是 30px）
  // Element Plus 对控件用的是固定 height（不是 min-height），必须一起覆盖
  :deep(.el-input__wrapper),
  :deep(.el-select__wrapper)
    height 30px
    min-height 30px
    padding 0 6px
    border-radius $syp-radius-sm

  // 数字输入框的高度在外层容器上，内核的输入框跟随它
  :deep(.el-input-number)
    height 30px
    line-height 30px

  :deep(.el-input__inner),
  :deep(.el-textarea__inner)
    font-size 12px

  :deep(.el-textarea__inner)
    padding 4px 6px
    line-height 1.4
    border-radius $syp-radius-sm

  // 分段控件（el-radio-button）靠相邻边框并拢成一体，容器不能加 gap，
  // 间距只加在普通单选/多选上
  :deep(.el-radio),
  :deep(.el-checkbox)
    margin-right 8px
    min-height 20px

  :deep(.el-radio__label),
  :deep(.el-checkbox__label)
    padding-left 4px
    font-size 12px

  :deep(.el-radio__inner),
  :deep(.el-checkbox__inner)
    width 12px
    height 12px

  :deep(.el-alert)
    --el-alert-padding 4px 6px
    padding 4px 6px
    margin-top 6px
    font-size 12px
    border-radius $syp-radius-sm

  // 各页 V1 容器继承的行高不同，会让同一条提示在这里 24px、那里 32px，统一钉死
  :deep(.el-alert__title)
    font-size 12px
    line-height 16px

  // 提示条在 V1 里自带内边距，需要同权重覆盖
  :deep(.el-alert.top-tip),
  :deep(.el-alert.desc-tip)
    padding 4px 6px

  // 按钮统一到 sm：默认尺寸在 V2 面板里明显偏大
  :deep(.el-button)
    height 24px
    min-height 24px
    padding 0 8px
    font-size 12px
    border-radius $syp-radius-sm

  :deep(.el-button + .el-button)
    margin-left 6px

  // 成组按钮（编辑模式「简洁/详细/源码」）靠相邻边框重叠并成一体。
  // 上面的通用间距与圆角规则跟组件库同权重、又后注入，会把整组拆散成三个独立按钮，
  // 这里必须显式还原，否则就失去了分段控件的意义。
  :deep(.el-button-group)
    display inline-flex

  :deep(.el-button-group .el-button)
    margin-left 0
    border-radius 0

    &:first-child
      border-top-left-radius $syp-radius-sm
      border-bottom-left-radius $syp-radius-sm

    &:last-child
      border-top-right-radius $syp-radius-sm
      border-bottom-right-radius $syp-radius-sm

  :deep(.el-button--large),
  :deep(.el-button--small)
    height 24px
    min-height 24px
    padding 0 8px
    font-size 12px

  // 单选/多选的大尺寸在此语境下没有意义
  :deep(.el-radio--large),
  :deep(.el-checkbox--large)
    height auto

  :deep(.el-divider)
    margin 8px 0

  // 平台图标栅格：V1 用的是 50px 级别的大图标，且图标盒比 SVG 小导致互相贴住
  :deep(.platform-item),
  :deep(.platform-icon)
    display inline-flex
    align-items center
    justify-content center
    width 22px
    height 22px
    font-size 22px
    line-height 1

    svg
      width 20px
      height 20px

  // 批量分发的平台图标栅格：V1 给图标盒 24×30、内层 SVG 却是 32×30，图标之间会互相贴住
  // 选择器需带上 V1 的容器类才能盖过它自己的权重
  :deep(.syp-distri-platform-container)
    display flex
    flex-wrap wrap
    align-items center
    gap 4px
    margin-top 6px

  // 每项是「平台图标 + 选中角标」两个行内兄弟节点，宽度必须自适应内容。
  // 未选中的 `.icon-no` 在 V1 里就是空路径（什么都不画），这里保留它的占位，
  // 这样点选平台时只是多出一个 ✓，不会因项宽变化把后面的图标整体推走。
  :deep(.syp-distri-platform-container .distri-item)
    display inline-flex
    align-items center
    justify-content flex-start
    gap 3px
    width auto
    min-width 0
    height 26px
    margin 0
    padding 0 4px
    border-radius $syp-radius-sm

    &:hover
      background var(--b3-theme-surface-lights, $syp-bg-secondary)

  :deep(.syp-distri-platform-container .distri-item .platform-icon)
    display inline-flex
    align-items center
    justify-content center
    flex 0 0 auto
    width 20px
    height 20px
    line-height 1

    svg
      width 18px
      height 18px

  // 选中角标在 V1 里没有自己的尺寸规则，会跟着图标一起溢出、压住相邻平台
  :deep(.syp-distri-platform-container .distri-item .icon-yes),
  :deep(.syp-distri-platform-container .distri-item .icon-no)
    display inline-flex
    align-items center
    justify-content center
    flex 0 0 auto
    width 13px
    height 13px
    line-height 1

    svg
      width 13px
      height 13px

  // 「详细发布」的平台选择卡片：V1 用 32px 字、32px 图标，单张卡片高达 100px
  // 选择器带上 .row-box / .icon-list 才够盖过 V1 自己的权重
  :deep(.row-box .platform-select-card)
    margin-bottom 8px

  :deep(.row-box .platform-select-card .card-item .el-card__body)
    padding 8px 12px

  :deep(.row-box .platform-select-card .icon-list)
    display flex
    align-items center
    justify-content center

  :deep(.row-box .platform-select-card .icon-list .define-item)
    font-size 13px
    line-height 20px

    .el-icon
      width 20px
      height 20px
      margin-right 6px

      svg
        width 18px
        height 18px

  :deep(.row-box .platform-select-card .el-badge)
    margin 0
    line-height 20px

    .el-badge__content
      height 14px
      padding 0 4px
      font-size 10px
      line-height 14px

  // 文章管理表格：默认单元格内边距偏高，行高比 V2 面板里的其他列表大一截
  :deep(.el-table)
    font-size 12px

  :deep(.el-table th.el-table__cell),
  :deep(.el-table td.el-table__cell)
    padding 4px 0
