# 宿主 Electron 调试地址 —— 项目级单点配置
#
# 只属于本仓库：不写用户级目录、不写全局配置。DSH / Codex / Claude 都从这里取值。
# 端口只在这里出现一次；客户端配置只引用启动器，不写具体端口。
#
# 键：
#   HOST_CDP_PORT         宿主上 Electron 应用本机监听的调试端口
#   HOST_CDP_RELAY_PORT   Windows portproxy 监听端口（0.0.0.0），转发给 WSL
#   HOST_CDP_URL          可选，显式完整地址；留空则各端自行推算
HOST_CDP_PORT=9222
HOST_CDP_RELAY_PORT=9223
HOST_CDP_URL=
